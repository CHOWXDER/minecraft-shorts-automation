# ── Copy this file to .env and fill in your real values ─────────────────────
# NEVER commit .env to git — it is already in .gitignore

# ── Anthropic (Claude AI scoring) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (TTS voice) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=tMvyQtpCVQ0DkixuYm6J   # optional — defaults to this voice

# ── Reddit API ────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MinecraftShortsBot/1.0 by u/your_username

# ── YouTube / Google ──────────────────────────────────────────────────────────
# Place your OAuth 2.0 client secrets file at: client_secrets.json
# (Google Cloud Console → APIs & Services → Credentials → Download JSON)

# ── Production overrides (optional) ──────────────────────────────────────────
# MINECRAFT_FOOTAGE_URL=https://www.youtube.com/watch?v=85z7jqGAGcc
# WHISPER_MODEL=base        # tiny | base | small | medium | large
# OUTPUT_DIR=output
